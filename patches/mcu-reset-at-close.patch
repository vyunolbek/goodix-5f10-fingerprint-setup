diff --git a/src/goodix.c b/src/goodix.c
index 236589f..93b38d7 100644
--- a/src/goodix.c
+++ b/src/goodix.c
@@ -57,6 +57,7 @@ typedef struct
 
   GCancellable       *transfer_cancel_tkn;
   gboolean            inited;
+  gboolean            session_dirty;
 } FpiDeviceGoodixTlsPrivate;
 
 G_DEFINE_ABSTRACT_TYPE_WITH_PRIVATE (FpiDeviceGoodixTls, fpi_device_goodixtls,
@@ -952,6 +953,43 @@ goodix_send_reset (FpDevice *dev, gboolean reset_sensor, guint8 sleep_time,
                         NULL);
 }
 
+void
+goodix_send_mcu_reset (FpDevice *dev)
+{
+  // Полный soft-reset MCU (0b011) одним синхронным bulk-write: без ACK-
+  // механизма (после сброса устройство переподключается к шине — ответа
+  // не будет, а read-loop к этому моменту уже останавливается).
+  GoodixReset payload = {.reset_sensor = TRUE,
+                         .soft_reset_mcu = TRUE,
+                         .sleep_time = 20};
+  guint8 *data;
+  guint32 data_len;
+  GError *error = NULL;
+
+  goodix_encode_protocol (GOODIX_CMD_RESET, (guint8 *) &payload,
+                          sizeof (payload), TRUE, FALSE, &data, &data_len);
+  if (!goodix_send_pack (dev, GOODIX_FLAGS_MSG_PROTOCOL, data, data_len,
+                         g_free, &error))
+    {
+      fp_dbg ("MCU reset at close failed: %s",
+              error ? error->message : "write failed");
+      g_clear_error (&error);
+    }
+  else
+    fp_dbg ("MCU reset at close sent (sensor+MCU, 0b011)");
+}
+
+// Пометить сессию как «грязную» (отмена/ошибка/таймаут): при закрытии будет
+// отправлен полный сброс MCU. Вызывается из TOD-модуля в путях ошибок.
+void
+goodix_tls_mark_session_dirty (FpDevice *dev)
+{
+  FpiDeviceGoodixTls *self = FPI_DEVICE_GOODIXTLS (dev);
+  FpiDeviceGoodixTlsPrivate *priv =
+    fpi_device_goodixtls_get_instance_private (self);
+  priv->session_dirty = TRUE;
+}
+
 void
 goodix_send_query_firmware_version (FpDevice                     *dev,
                                     GoodixFirmwareVersionCallback callback,
@@ -1200,6 +1238,20 @@ goodix_dev_deinit (FpDevice *dev, GError **error)
   g_cancellable_cancel (priv->transfer_cancel_tkn);
   goodix_shutdown_tls (dev, error);
 
+  // Сброс MCU — только после «грязных» сессий (отмена verify, смерть клиента,
+  // suspend с открытым claim): тогда MCU остаётся в плохом состоянии и кадры
+  // следующей сессии нераспознаваемы (score 0-10 по всем шаблонам).
+  // Чистые сессии НЕ сбрасываем: постоянная переэнумерация USB пересоздаёт
+  // объект fprintd с новым путём /Device/N и порождает гонки клиентов
+  // («Object does not exist at path …», «Device was already claimed»).
+  if (priv->session_dirty)
+    {
+      goodix_send_mcu_reset (dev);
+      priv->session_dirty = FALSE;
+    }
+  else
+    fp_dbg ("clean session — MCU reset skipped");
+
   goodix_reset_state (dev);
   priv->inited = FALSE;
 
diff --git a/src/goodix.h b/src/goodix.h
index 08bc254..3042a40 100644
--- a/src/goodix.h
+++ b/src/goodix.h
@@ -394,6 +394,18 @@ void goodix_send_reset (FpDevice           *dev,
                         GoodixResetCallback callback,
                         gpointer            user_data);
 
+/**
+ * @brief Полный soft-reset (сенсор + MCU, биты 0b011) одним синхронным write.
+ *
+ * Fire-and-forget без ожидания ACK: после этой команды MCU перезагружается
+ * и устройство переподключается к шине (ответа не будет и не надо).
+ */
+void goodix_send_mcu_reset (FpDevice *dev);
+
+// Пометить текущую сессию как завершившуюся с ошибкой/отменой:
+// при закрытии устройства будет отправлен полный сброс MCU (см. goodix_dev_deinit).
+void goodix_tls_mark_session_dirty (FpDevice *dev);
+
 /**
  * @brief Ask the device what firmware version it is running. Response is null-terminated string
  *
diff --git a/src/goodix5f10.c b/src/goodix5f10.c
index 46b55a0..6f4a35c 100644
--- a/src/goodix5f10.c
+++ b/src/goodix5f10.c
@@ -479,7 +479,14 @@ tls_ready (FpDevice *dev, gpointer user_data, GError *err)
 static void
 act_complete (FpiSsm *ssm, FpDevice *dev, GError *err)
 {
-  if (err) { fpi_device_open_complete (dev, err); return; }
+  if (err)
+    {
+      // активация/TLS упала — сенсор в неизвестном состоянии, следующий заход
+      // должен начаться со сброса MCU
+      goodix_tls_mark_session_dirty (dev);
+      fpi_device_open_complete (dev, err);
+      return;
+    }
   goodix_tls_init (dev, tls_ready, NULL);
 }
 
@@ -522,9 +529,15 @@ static void
 enroll_capture_cb (FpDevice *dev, GError *err)
 {
   FpiDeviceGoodixTls5f10 *self = FPI_DEVICE_GOODIXTLS5F10 (dev);
-  if (err) { fpi_device_enroll_complete (dev, NULL, err); return; }
+  if (err)
+    {
+      goodix_tls_mark_session_dirty (dev);
+      fpi_device_enroll_complete (dev, NULL, err);
+      return;
+    }
   if (fpi_device_action_is_cancelled (dev))
     {
+      goodix_tls_mark_session_dirty (dev);
       fpi_device_enroll_complete (dev, NULL,
         fpi_device_error_new (FP_DEVICE_ERROR_GENERAL));
       return;
@@ -593,7 +606,15 @@ static void
 verify_capture_cb (FpDevice *dev, GError *err)
 {
   FpiDeviceGoodixTls5f10 *self = FPI_DEVICE_GOODIXTLS5F10 (dev);
-  if (err) { fpi_device_verify_complete (dev, err); return; }
+  if (err)
+    {
+      // отмена (пользователь ушёл на пароль, клиент умер) или сбой — сенсор
+      // после этого отдаёт мусорные кадры, сбрасываем MCU при закрытии.
+      // Чистый no-match сюда НЕ попадает: err == NULL.
+      goodix_tls_mark_session_dirty (dev);
+      fpi_device_verify_complete (dev, err);
+      return;
+    }
 
   fpi_device_verify_report (dev,
     self->cap_matched ? FPI_MATCH_SUCCESS : FPI_MATCH_FAIL, NULL, NULL);
